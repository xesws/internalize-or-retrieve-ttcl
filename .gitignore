/models/
/cache/
/hf_cache/

# --- python ---
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.egg-info/
build/
dist/

# --- latex build crumbs (keep paper/main.pdf for review) ---
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.log
paper/*.toc

# --- os / editor ---
.DS_Store
.idea/
.vscode/
